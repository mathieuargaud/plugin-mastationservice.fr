{
  "manifest_version": 3,
  "name": "MaStationService – prix des carburants",
  "description": "Les stations les moins chères autour de vous, en temps réel.",
  "version": "1.0.0",
  "permissions": ["geolocation", "storage"],
  "host_permissions": ["https://www.mastationservice.fr/*"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "MaStationService",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
